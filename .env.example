# ---------------------------------------------------------------------------
# KYC Copilot — environment configuration
# Copy to .env and fill in what you have. Everything works in mock mode with
# an empty file (SQLite + in-memory cache + deterministic planner).
# ---------------------------------------------------------------------------

APP_ENV=development
DEBUG=true

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Used to encrypt the PII vault at rest and to sign
# format-preserving surrogates. Rotating it invalidates existing vaults.
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ADMIN_TOKEN=change-me-admin-token

# --- Database ---------------------------------------------------------------
# Local default (SQLite). For Supabase/Postgres paste the REAL connection
# string from your provider dashboard. The value below is a placeholder and
# will not resolve: never copy it into Render/Vercel environment settings.
# The app normalises postgres:// -> postgresql+psycopg:// automatically.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Redis (idempotency, cache, session state) ------------------------------
# Optional. If unreachable the app falls back to a process-local TTL cache and
# /health reports redis.mode = "in-memory".
REDIS_URL=redis://localhost:6379/0

# --- Vector store for KYC policy RAG ---------------------------------------
# auto   -> use ChromaDB if importable, else local BM25-style retriever
# chroma -> require ChromaDB
# local  -> never load ChromaDB
POLICY_BACKEND=auto
CHROMA_DIR=./data/chroma

# --- LLM --------------------------------------------------------------------
# auto   -> use Gemini if GEMINI_API_KEY set, else Groq if GROQ_API_KEY set,
#           else deterministic mock planner (fully offline).
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200

# Estimated cost accounting (USD per 1M tokens). Override to match your plan.
PRICE_INPUT_PER_MTOK=0.30
PRICE_OUTPUT_PER_MTOK=2.50

# --- Simulated integrations -------------------------------------------------
# Bank mandate gateway deliberately fails this often (0..1).
MOCK_MANDATE_FAILURE_RATE=0.2
MOCK_OCR_MIN_CONFIDENCE=0.85
# Fixed seed keeps eval runs reproducible; set empty for true randomness.
MOCK_SEED=kyc-copilot

# --- Evaluation harness -----------------------------------------------------
# Override inside Docker to point at the mounted ./evals directory.
# EVALS_DIR=/evals/scenarios
# EVALS_REPORTS_DIR=/evals/reports

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- Kill switch ------------------------------------------------------------
# When true, no new agent actions are dispatched.
KILL_SWITCH_DEFAULT=false
